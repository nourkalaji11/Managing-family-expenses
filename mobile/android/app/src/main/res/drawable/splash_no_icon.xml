<?xml version="1.0" encoding="utf-8"?>
<!--
    A fully transparent drawable used as the Android 12+ splash icon.

    From API 31 the platform SplashScreen API always draws a centred icon and
    defaults to the launcher icon, which is why the Flutter logo appeared even
    though `launch_background.xml` is a plain white layer. The icon slot cannot
    be removed, so it is filled with nothing instead.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
