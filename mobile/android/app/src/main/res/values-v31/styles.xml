<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 (API 31) and up.

    The platform SplashScreen API replaced the plain `windowBackground` splash
    with a composed one that always centres an icon, defaulting to the launcher
    icon. That is where the Flutter logo on the launch screen came from; it is
    not in `launch_background.xml`, which is a plain white layer.

    The icon slot cannot be turned off, so it points at a transparent drawable.
    The result is the flat white launch screen the design asks for, with nothing
    drawn on it.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_no_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
