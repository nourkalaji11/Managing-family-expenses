<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 (API 31)+ composes the launch screen with the platform
     SplashScreen API, which always centres an icon and defaults to the launcher
     icon. That is the Flutter logo on startup; it is not in
     launch_background.xml, which is a plain white layer. The slot cannot be
     turned off, so it points at a transparent drawable. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_no_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
